<UserControl x:Class="Radiacode.App.Views.SpectrumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Radiacode.App.Controls"
             xmlns:vm="using:Radiacode.App.ViewModels"
             xmlns:app="using:Radiacode.App">
  <Grid Padding="12,0,12,0">
    <Grid x:Name="SpectrumLayout" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="LinesColumn" Width="400" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="SpectrumRow" Height="*" />
        <RowDefinition x:Name="LinesRow" Height="0" />
      </Grid.RowDefinitions>

      <!-- Large spectrum -->
      <Border x:Name="SpectrumCard" Style="{StaticResource Card}">
        <Grid RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Style="{StaticResource CardTitle}" Text="Energy spectrum" />
              <TextBlock Style="{StaticResource Muted}" Text="{x:Bind ViewModel.SpectrumInfo, Mode=OneWay}" />
              <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{x:Bind ViewModel.CalibrationText, Mode=OneWay}" />
              <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{x:Bind ViewModel.BackgroundCompareText, Mode=OneWay}" />
              <TextBlock Style="{StaticResource Muted}" FontSize="13" Foreground="{ThemeResource OkBrush}" Text="{x:Bind ViewModel.SpectrumExportText, Mode=OneWay}"
                         Visibility="{x:Bind app:Ui.ShowIf(ViewModel.SpectrumExportText), Mode=OneWay}" />
              <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="Hover for values · mouse wheel zooms · drag to pan · double-click resets" />
            </StackPanel>
            <StackPanel x:Name="SpectrumActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <ToggleSwitch OnContent="Log" OffContent="Linear" MinWidth="0" IsOn="{x:Bind ViewModel.SpectrumLog, Mode=TwoWay}" />
              <ComboBox MinWidth="190" SelectedIndex="{x:Bind ViewModel.BackgroundModeIndex, Mode=TwoWay}" VerticalAlignment="Center"
                        ToolTipService.ToolTip="Compare with the saved background spectrum">
                <x:String>Spectrum</x:String>
                <x:String>With background</x:String>
                <x:String>Minus background</x:String>
              </ComboBox>
              <Button Content="Save as background…" Click="SaveBackground_Click" />
              <Button Content="Export CSV" Command="{x:Bind ViewModel.ExportSpectrumCommand}" />
              <Button Content="Reset spectrum…" Click="ResetSpectrum_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
            </StackPanel>
          </Grid>
          <controls:LineChart Grid.Row="1" MinHeight="320" Unit="counts / channel"
                              Stroke="{StaticResource AccentBrush}"
                              LogScale="{x:Bind ViewModel.SpectrumPageLog, Mode=OneWay}"
                              Values="{x:Bind ViewModel.SpectrumPageValues, Mode=OneWay}"
                              Overlay="{x:Bind ViewModel.SpectrumOverlay, Mode=OneWay}"
                              XValue="{x:Bind ViewModel.SpectrumX, Mode=OneWay}"
                              XFormat="{x:Bind ViewModel.KeVFormat}" Zoomable="True"
                              Markers="{x:Bind ViewModel.SpectrumMarkers, Mode=OneWay}" />

        </Grid>
      </Border>

      <!-- Lines of interest -->
      <Border x:Name="LinesCard" Grid.Column="1" Style="{StaticResource Card}">
        <Grid RowSpacing="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource CardTitle}" Text="Lines of interest" />
            <TextBlock Style="{StaticResource Muted}" FontSize="13"
                       Text="Net counts in a ±0.6 FWHM window vs. neighbouring channels. ≥ 3σ means the line is most likely present. Indicative only — no peak fitting, and a cold detector shifts the energy scale by a few %." />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{x:Bind ViewModel.SpectrumLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:LineRow">
                  <Grid Padding="0,6" ColumnSpacing="8" Opacity="{x:Bind Opacity}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="70" />
                      <ColumnDefinition Width="104" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock FontFamily="{StaticResource CardFont}" FontSize="15" FontWeight="Bold" Text="{x:Bind Nuclide}" />
                      <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{x:Bind Energy}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" FontFamily="{StaticResource CardFont}" FontSize="15" VerticalAlignment="Center" TextAlignment="Right" Text="{x:Bind Significance}" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock FontFamily="{StaticResource CardFont}" FontSize="14" FontWeight="SemiBold" Text="{x:Bind Verdict}" />
                      <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="{x:Bind Origin}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- Narrow window: lines table below the spectrum, actions under the title -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="LinesColumn.Width" Value="0" />
            <Setter Target="SpectrumLayout.ColumnSpacing" Value="0" />
            <Setter Target="SpectrumLayout.RowSpacing" Value="12" />
            <Setter Target="SpectrumRow.Height" Value="3*" />
            <Setter Target="LinesRow.Height" Value="2*" />
            <Setter Target="LinesCard.(Grid.Row)" Value="1" />
            <Setter Target="LinesCard.(Grid.Column)" Value="0" />
            <Setter Target="SpectrumActions.(Grid.Row)" Value="1" />
            <Setter Target="SpectrumActions.(Grid.Column)" Value="0" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</UserControl>
