<UserControl x:Class="Radiacode.App.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <Grid Padding="12,0,12,0" ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Style="{StaticResource CardTitle}" Text="Device" />
            <Grid ColumnSpacing="12" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Muted}" Text="Serial number" />
              <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.Serial, Mode=OneWay}" />
              <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Firmware" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.FirmwareText, Mode=OneWay}" />
              <TextBlock Grid.Row="5" Style="{StaticResource Muted}" Text="Firmware update" />
              <StackPanel Grid.Row="5" Grid.Column="1" Spacing="2">
                <TextBlock Style="{StaticResource Value}" Text="{x:Bind ViewModel.FirmwareUpdateText, Mode=OneWay}" />
                <HyperlinkButton Padding="0" Content="radiacode.com/downloads" NavigateUri="{x:Bind ViewModel.FirmwareDownloadsUrl}"
                                 Visibility="{x:Bind ViewModel.FirmwareUpdateAvailable, Mode=OneWay}" />
              </StackPanel>
              <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Connection" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.TransportText, Mode=OneWay}" />
              <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="Spectrum format" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.SpectrumFormatText, Mode=OneWay}" />
              <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Text="Status" />
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Style="{StaticResource CardTitle}" Text="Condition" />
            <Grid ColumnSpacing="12" RowSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Muted}" Text="Battery" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" VerticalAlignment="Center" Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.BatteryBrush, Mode=OneWay}" />
                <TextBlock Style="{StaticResource Value}" VerticalAlignment="Center">
                  <Run Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.BatteryStateText, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Text="Temperature" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}" />
              <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Text="Accumulated dose" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}">
                <Run Text="{x:Bind ViewModel.DoseText, Mode=OneWay}" /><Run Text=" µSv " /><Run Text="{x:Bind ViewModel.DoseDurationText, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Text="Last reading" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Bind ViewModel.LastReadingText, Mode=OneWay}" />
            </Grid>
            <TextBlock Style="{StaticResource Muted}" FontSize="13"
                       Text="Battery % and the device's dose counter are only reported when connecting; the dose is then integrated live from the dose rate. Charging state comes with every reading; temperature is read every 10 s." />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Style="{StaticResource CardTitle}" Text="Energy calibration" />
            <TextBlock Style="{StaticResource Value}" Text="{x:Bind ViewModel.CalibrationText, Mode=OneWay}" />
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="Channel → energy polynomial stored on the device; read with every spectrum." />
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel Spacing="10">
            <TextBlock Style="{StaticResource CardTitle}" Text="Actions" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Reset spectrum…" Click="ResetSpectrum_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
              <Button Content="Reset accumulated dose…" Click="ResetDose_Click" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="Both act on the device itself and ask for confirmation first." />
          </StackPanel>
        </Border>

        <!-- Settings stored on the device itself -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}">
          <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="Device settings" />
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{x:Bind ViewModel.DeviceSettingsText, Mode=OneWay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Reload" Command="{x:Bind ViewModel.ReloadDeviceSettingsCommand}" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
                <Button Content="Write to device" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplyDeviceSettingsCommand}"
                        IsEnabled="{x:Bind ViewModel.DeviceSettingsLoaded, Mode=OneWay}" />
              </StackPanel>
            </Grid>

            <Grid ColumnSpacing="24" RowSpacing="12" IsHitTestVisible="{x:Bind ViewModel.DeviceSettingsLoaded, Mode=OneWay}">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

              <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource Label}" Text="SOUND &amp; VIBRATION" />
                <ToggleSwitch Header="Sound" IsOn="{x:Bind ViewModel.DevSoundOn, Mode=TwoWay}" />
                <Slider Header="Volume" Minimum="0" Maximum="100" StepFrequency="10" TickFrequency="10" TickPlacement="BottomRight"
                        Value="{x:Bind ViewModel.DevSoundVolume, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DevHasVolume, Mode=OneWay}"
                        MaxWidth="280" HorizontalAlignment="Left" MinWidth="220" />
                <CheckBox Content="Click sound for each detected particle" IsChecked="{x:Bind ViewModel.DevClickSound, Mode=TwoWay}" />
                <CheckBox Content="Button press sound" IsChecked="{x:Bind ViewModel.DevButtonSound, Mode=TwoWay}" />
                <ToggleSwitch Header="Vibration" IsOn="{x:Bind ViewModel.DevVibrationOn, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource Muted}" FontSize="13"
                           Text="Clicks are only heard when Sound is on. The LED flashes for every particle regardless; this firmware (4.15) has no setting for it." />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Style="{StaticResource Label}" Text="DISPLAY" />
                <Slider Header="Brightness" Minimum="0" Maximum="9" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight"
                        Value="{x:Bind ViewModel.DevBrightness, Mode=TwoWay}" MaxWidth="280" HorizontalAlignment="Left" MinWidth="220" />
                <ComboBox Header="Turn off after" MinWidth="160" SelectedIndex="{x:Bind ViewModel.DevDisplayOffIndex, Mode=TwoWay}">
                  <x:String>5 s</x:String>
                  <x:String>10 s</x:String>
                  <x:String>15 s</x:String>
                  <x:String>30 s</x:String>
                  <x:String>2 min</x:String>
                  <x:String>5 min</x:String>
                </ComboBox>
                <ComboBox Header="Orientation" MinWidth="160" SelectedIndex="{x:Bind ViewModel.DevDirectionIndex, Mode=TwoWay}">
                  <x:String>Automatic</x:String>
                  <x:String>Right-handed</x:String>
                  <x:String>Left-handed</x:String>
                </ComboBox>
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Style="{StaticResource Label}" Text="DEVICE ALARM THRESHOLDS" />
                <Grid ColumnSpacing="8" RowSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                  <TextBlock Grid.Column="1" Style="{StaticResource Muted}" FontSize="13" Text="Level 1" />
                  <TextBlock Grid.Column="2" Style="{StaticResource Muted}" FontSize="13" Text="Level 2" />
                  <TextBlock Grid.Row="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Dose rate, nSv/h" />
                  <NumberBox Grid.Row="1" Grid.Column="1" Minimum="0" Value="{x:Bind ViewModel.DevDoseRateAlarm1, Mode=TwoWay}" />
                  <NumberBox Grid.Row="1" Grid.Column="2" Minimum="0" Value="{x:Bind ViewModel.DevDoseRateAlarm2, Mode=TwoWay}" />
                  <TextBlock Grid.Row="2" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Count rate, cps" />
                  <NumberBox Grid.Row="2" Grid.Column="1" Minimum="0" Value="{x:Bind ViewModel.DevCountRateAlarm1, Mode=TwoWay}" />
                  <NumberBox Grid.Row="2" Grid.Column="2" Minimum="0" Value="{x:Bind ViewModel.DevCountRateAlarm2, Mode=TwoWay}" />
                  <TextBlock Grid.Row="3" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="Dose, µSv" />
                  <NumberBox Grid.Row="3" Grid.Column="1" Minimum="0" Value="{x:Bind ViewModel.DevDoseAlarm1, Mode=TwoWay}" />
                  <NumberBox Grid.Row="3" Grid.Column="2" Minimum="0" Value="{x:Bind ViewModel.DevDoseAlarm2, Mode=TwoWay}" />
                </Grid>
                <TextBlock Style="{StaticResource Muted}" FontSize="13"
                           Text="These alarms run on the device itself (sound/vibration/LED), independent of the app's own alarm in Settings. Very large values mean the alarm is effectively off." />
              </StackPanel>

              <StackPanel Grid.Row="1" Spacing="4" IsHitTestVisible="{x:Bind ViewModel.DevHasUnits, Mode=OneWay}">
                <TextBlock Style="{StaticResource Label}" Text="UNITS (ON THE DEVICE)" />
                <ComboBox Header="Dose units" MinWidth="160" SelectedIndex="{x:Bind ViewModel.DevDoseUnitsIndex, Mode=TwoWay}">
                  <x:String>Sievert (Sv)</x:String>
                  <x:String>Roentgen (R)</x:String>
                </ComboBox>
                <CheckBox Content="Show low dose rates in nSv/h" IsChecked="{x:Bind ViewModel.DevNanoSievert, Mode=TwoWay}" />
                <ComboBox Header="Count rate" MinWidth="160" SelectedIndex="{x:Bind ViewModel.DevCountUnitsIndex, Mode=TwoWay}">
                  <x:String>Counts per second (cps)</x:String>
                  <x:String>Counts per minute (cpm)</x:String>
                </ComboBox>
                <ComboBox Header="Temperature" MinWidth="160" SelectedIndex="{x:Bind ViewModel.DevTempUnitsIndex, Mode=TwoWay}">
                  <x:String>Celsius (°C)</x:String>
                  <x:String>Fahrenheit (°F)</x:String>
                </ComboBox>

                <TextBlock Style="{StaticResource Muted}" FontSize="13"
                           Text="Changes what the detector's own screen shows. The app always uses nSv/h, cps and °C." />
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="4">
                <TextBlock Style="{StaticResource Label}" Text="DIAGNOSTICS (READ-ONLY)" />
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Muted}" Text="{x:Bind ViewModel.DeviceDiagnosticNames, Mode=OneWay}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Value}" IsTextSelectionEnabled="True"
                             Text="{x:Bind ViewModel.DeviceDiagnosticValues, Mode=OneWay}" />
                </Grid>
                <TextBlock Style="{StaticResource Muted}" FontSize="13"
                           Text="Values from the detector's internal register map. Calibration and power registers are only shown, never changed by the app." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
