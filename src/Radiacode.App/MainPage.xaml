<Page x:Class="Radiacode.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Radiacode.App.Controls"
      xmlns:views="using:Radiacode.App.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Ambient layer behind everything: Cherenkov-blue light that tints the Mica backdrop and
         shines through the translucent cards. Breathes while a device is streaming. -->
    <Grid x:Name="AmbientLayer" Grid.RowSpan="4" IsHitTestVisible="False">
      <Grid.Resources>
        <Storyboard x:Key="Breath" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetName="AmbientGlow" Storyboard.TargetProperty="Opacity" From="0.14" To="0.32" Duration="0:0:1.4">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </Grid.Resources>
      <!-- zero-size anchor in the bottom-right corner, so the oversized art never inflates the page layout -->
      <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Ellipse x:Name="AmbientGlow" Width="1300" Height="1300" Opacity="0.14" Canvas.Left="-780" Canvas.Top="-740">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FF2F8CFF" Offset="0" />
              <GradientStop Color="#663D5BFF" Offset="0.45" />
              <GradientStop Color="#005B3DF5" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <controls:CherenkovLogo Width="820" Height="820" Opacity="0.10" Canvas.Left="-620" Canvas.Top="-580"
                                IsActive="{x:Bind ViewModel.PulseActive, Mode=OneWay}" PulseSpeed="{x:Bind ViewModel.PulseSpeed, Mode=OneWay}" />
      </Canvas>
    </Grid>

    <!-- Header: brand left, device status centred between the brand and the caption buttons; on Windows also the drag region -->
    <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,152,0" Background="Transparent" ColumnSpacing="16">
      <Grid.Resources>
        <!-- One soft pulse of Cherenkov glow behind the status for every reading that arrives -->
        <Storyboard x:Key="StatusPulse">
          <DoubleAnimation Storyboard.TargetName="StatusGlow" Storyboard.TargetProperty="Opacity" From="0.9" To="0.2" Duration="0:0:0.9">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
          </DoubleAnimation>
        </Storyboard>
      </Grid.Resources>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <controls:CherenkovLogo Width="26" Height="26" IsActive="{x:Bind ViewModel.PulseActive, Mode=OneWay}" PulseSpeed="{x:Bind ViewModel.PulseSpeed, Mode=OneWay}" />
        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Text="Radiacode Companion" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Text="{x:Bind ViewModel.Serial, Mode=OneWay}" />
        <Grid VerticalAlignment="Center">
          <Ellipse x:Name="StatusGlow" Opacity="0" Margin="-22,-12" IsHitTestVisible="False">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#B32F8CFF" Offset="0" />
                <GradientStop Color="#4D3D5BFF" Offset="0.55" />
                <GradientStop Color="#005B3DF5" Offset="1" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusLabel" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       MaxWidth="360" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="HeaderBattery" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" VerticalAlignment="Center"
                    Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}" Foreground="{x:Bind ViewModel.BatteryBrush, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.BatteryStateText, Mode=OneWay}" />
          <TextBlock FontSize="16" VerticalAlignment="Center" Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}"
                     ToolTipService.ToolTip="{x:Bind ViewModel.BatteryStateText, Mode=OneWay}" />
        </StackPanel>
        <StackPanel x:Name="HeaderDetector" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Text="Detector" />
          <TextBlock FontSize="16" Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
    </Grid>
    <!-- Dose-rate alarm -->
    <InfoBar Grid.Row="1" Margin="12,0,12,12" Severity="Error" Title="Dose rate alarm" IsClosable="False"
             IsOpen="{x:Bind ViewModel.AlarmActive, Mode=OneWay}" Message="{x:Bind ViewModel.AlarmText, Mode=OneWay}" />

    <!-- Pages -->
    <Grid Grid.Row="2">
      <!-- Overview fills the window: KPI row on top, charts take all remaining height and grow with the window -->
      <Grid x:Name="OverviewPage" Padding="12,0,12,0" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <!-- KPI row -->
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource Label}" Text="DOSE RATE" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource BigValue}" Text="{x:Bind ViewModel.DoseRateText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,8" Text="nSv/h" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Muted}" Text="{x:Bind ViewModel.DoseRateErrorText, Mode=OneWay}" />
                  <TextBlock FontFamily="{StaticResource CardFont}" FontSize="15" Foreground="{ThemeResource OkBrush}" Text="{x:Bind ViewModel.DoseRateState, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource Label}" Text="COUNT RATE" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource BigValue}" Text="{x:Bind ViewModel.CountRateText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,8" Text="cps" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Muted}" Text="{x:Bind ViewModel.CountRateErrorText, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource Label}" Text="ACCUMULATED DOSE" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Style="{StaticResource BigValue}" Text="{x:Bind ViewModel.DoseText, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="18" VerticalAlignment="Bottom" Margin="0,0,0,8" Text="µSv" />
                  </StackPanel>
                  <TextBlock Style="{StaticResource Muted}" Text="{x:Bind ViewModel.DoseDurationText, Mode=OneWay}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="3" Style="{StaticResource Card}">
                <StackPanel Spacing="6">
                  <TextBlock Style="{StaticResource Label}" Text="HARDNESS" />
                  <TextBlock Style="{StaticResource BigValue}" Text="{x:Bind ViewModel.HardnessText, Mode=OneWay}" />
                  <TextBlock Style="{StaticResource Muted}" Text="dose rate ÷ count rate · Cs-137 ≈ 1.45" />
                </StackPanel>
              </Border>
            </Grid>


            <!-- Spectrum + time series -->
            <Grid Grid.Row="1" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}">
                <Grid RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Grid>
                    <StackPanel>
                      <TextBlock Style="{StaticResource CardTitle}" Text="Energy spectrum" />
                      <TextBlock Style="{StaticResource Muted}" Text="{x:Bind ViewModel.SpectrumInfo, Mode=OneWay}" />
                    </StackPanel>
                    <ToggleSwitch HorizontalAlignment="Right" OnContent="Log" OffContent="Linear"
                                  IsOn="{x:Bind ViewModel.SpectrumLog, Mode=TwoWay}" />
                  </Grid>
                  <controls:LineChart Grid.Row="1" MinHeight="160" Unit="counts / channel"
                                      Stroke="{StaticResource AccentBrush}"
                                      LogScale="{x:Bind ViewModel.SpectrumLog, Mode=OneWay}"
                                      Values="{x:Bind ViewModel.SpectrumCounts, Mode=OneWay}"
                                      XValue="{x:Bind ViewModel.SpectrumX, Mode=OneWay}"
                                      XFormat="{x:Bind ViewModel.KeVFormat}" Zoomable="True"
                                      Markers="{x:Bind ViewModel.SpectrumMarkersDetected, Mode=OneWay}" />
                </Grid>
              </Border>
              <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                  <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Dose rate · last 10 min" />
                    <controls:LineChart Grid.Row="1" MinHeight="50" Unit="nSv/h" Stroke="{StaticResource DoseBrush}"
                                        Values="{x:Bind ViewModel.DoseHistory, Mode=OneWay}"
                                        XValue="{x:Bind ViewModel.DoseX, Mode=OneWay}" XFormat="{x:Bind ViewModel.MinutesAgoFormat}" />
                  </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                  <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Count rate · last 10 min" />
                    <controls:LineChart Grid.Row="1" MinHeight="50" Unit="cps" Stroke="{StaticResource CountBrush}"
                                        Values="{x:Bind ViewModel.CountHistory, Mode=OneWay}"
                                        XValue="{x:Bind ViewModel.CountX, Mode=OneWay}" XFormat="{x:Bind ViewModel.MinutesAgoFormat}" />
                  </Grid>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                  <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Hardness · pink = Cs-137 reference" />
                    <controls:LineChart Grid.Row="1" MinHeight="50" Unit="µrem/h per cps" Stroke="{StaticResource HardnessBrush}"
                                        ReferenceValue="1.45"
                                        Values="{x:Bind ViewModel.HardnessHistory, Mode=OneWay}"
                                        XValue="{x:Bind ViewModel.HardnessX, Mode=OneWay}" XFormat="{x:Bind ViewModel.MinutesAgoFormat}" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
      </Grid>

      <views:SpectrumView x:Name="SpectrumPage" Visibility="Collapsed" />
      <views:HistoryView x:Name="HistoryPage" Visibility="Collapsed" />
      <views:EventsView x:Name="EventsPage" Visibility="Collapsed" />
      <views:DeviceView x:Name="DevicePage" Visibility="Collapsed" />
      <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
    </Grid>

    <!-- Bottom: one centred card with navigation and device actions; actions drop to a second row in a narrow window -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4" Margin="12" HorizontalAlignment="Center">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
          <Button x:Name="NavOverview" Tag="Overview" Content="Overview" Style="{StaticResource NavButtonSelected}" Click="Nav_Click" />
          <Button x:Name="NavSpectrum" Tag="Spectrum" Content="Spectrum" Style="{StaticResource NavButton}" Click="Nav_Click" />
          <Button x:Name="NavHistory" Tag="History" Content="History" Style="{StaticResource NavButton}" Click="Nav_Click" />
          <Button x:Name="NavEvents" Tag="Events" Content="Events" Style="{StaticResource NavButton}" Click="Nav_Click" />
          <Button x:Name="NavDevice" Tag="Device" Content="Device" Style="{StaticResource NavButton}" Click="Nav_Click" />
          <Button x:Name="NavSettings" Tag="Settings" Content="Settings" Style="{StaticResource NavButton}" Click="Nav_Click" />
        </StackPanel>
        <StackPanel x:Name="ActionGroup" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Rectangle x:Name="ActionDivider" Width="1" Margin="4,8" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
          <Button Content="{x:Bind ViewModel.ConnectText, Mode=OneWay}" MinWidth="96" Command="{x:Bind ViewModel.ToggleConnectionCommand}" />
          <Button x:Name="PauseButton" Content="{x:Bind ViewModel.PauseText, Mode=OneWay}" MinWidth="80"
                  Command="{x:Bind ViewModel.TogglePauseCommand}" IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}" />
        </StackPanel>
      </Grid>
    </Border>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="WidthStates">
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="740" /></VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ActionGroup.(Grid.Row)" Value="1" />
            <Setter Target="ActionGroup.(Grid.Column)" Value="0" />
            <Setter Target="ActionGroup.Margin" Value="0,4,0,0" />
            <Setter Target="ActionDivider.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <!-- Header keeps serial + status; battery and temperature need more room (they are also on the Device page) -->
      <VisualStateGroup x:Name="HeaderStates">
        <VisualState x:Name="HeaderFull">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="HeaderCompact">
          <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="HeaderBattery.Visibility" Value="Collapsed" />
            <Setter Target="HeaderDetector.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ConnectionStates">
        <VisualState x:Name="Offline" />
        <VisualState x:Name="Live">
          <VisualState.Setters>
            <Setter Target="StatusDot.Fill" Value="{ThemeResource OkBrush}" />
            <Setter Target="StatusLabel.Foreground" Value="{ThemeResource OkBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Paused">
          <VisualState.Setters>
            <Setter Target="StatusDot.Fill" Value="{ThemeResource SystemFillColorCautionBrush}" />
            <Setter Target="StatusLabel.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>