<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.26100;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Radiacode Companion</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.lauri.radiacodecompanion</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Lauri</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Unofficial companion app for RadiaCode detectors.</Description>
    <!-- Splash screen: Cherenkov logo on a transparent background, so Windows draws it in the light/dark theme colour -->
    <UnoSplashScreenColor>transparent</UnoSplashScreenColor>
    <!--
      If you encounter this error message:

        error NETSDK1148: A referenced assembly was compiled using a newer version of Microsoft.Windows.SDK.NET.dll.
        Please update to a newer .NET SDK in order to reference this assembly.

      This means that the two packages below must be aligned with the "build" version number of
      the "Microsoft.Windows.SDK.BuildTools" package above, and the "revision" version number
      must be the highest found in https://www.nuget.org/packages/Microsoft.Windows.SDK.NET.Ref.
    -->
    <!-- <WindowsSdkPackageVersion>10.0.22621.28</WindowsSdkPackageVersion> -->

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Mvvm;
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tmds.DBus" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Radiacode.Core\Radiacode.Core.csproj" />
    <ProjectReference Include="..\Radiacode.Transport.LibUsb\Radiacode.Transport.LibUsb.csproj" />
    <ProjectReference Include="..\Radiacode.Transport.Ble\Radiacode.Transport.Ble.csproj" />
  </ItemGroup>
  <!--
    MSIX splash screen: Cherenkov logo on BackgroundColor="transparent", which Windows draws in the
    light/dark theme colour (as in the OWON companion app). Uno.Resizetizer only writes hex colours
    into the generated manifest, so patch its output before packaging.
  -->
  <Target Name="RcThemedSplashScreen" AfterTargets="UnoResizetizeImages" Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <ItemGroup>
      <_RcManifest Include="@(AppxManifest)" />
    </ItemGroup>
    <WriteLinesToFile Condition="'@(_RcManifest)' != ''" File="%(_RcManifest.FullPath)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Lines="$([MSBuild]::Escape($([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(_RcManifest.FullPath)')), '(SplashScreen[^>]*BackgroundColor=&quot;)[^&quot;]*', '${1}transparent'))))" />
  </Target>
</Project>