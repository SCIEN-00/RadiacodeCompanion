<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows TFM so the ble option uses WinRT Bluetooth on Windows; net10.0 uses BlueZ on Linux -->
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <AssemblyName>rccli</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tmds.DBus" Version="0.95.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Radiacode.Core\Radiacode.Core.csproj" />
    <ProjectReference Include="..\Radiacode.Transport.LibUsb\Radiacode.Transport.LibUsb.csproj" />
    <ProjectReference Include="..\Radiacode.Transport.Ble\Radiacode.Transport.Ble.csproj" />
  </ItemGroup>
</Project>
